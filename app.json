{
  "expo": {
    "name": "الشفرة",
    "slug": "arabic-codenames",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "codenames",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#08121F",
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "نحتاج إلى الكاميرا لمسح رمز الغرفة",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arabiccodenames.game",
      "icon": "./assets/app-icon.png",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "NSCameraUsageDescription": "نحتاج إلى الكاميرا لمسح رمز الغرفة"
      }
    },
    "android": {
      "package": "com.arabiccodenames.game",
      "adaptiveIcon": {
        "backgroundColor": "#08121F",
        "foregroundImage": "./assets/game-icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA"],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [{ "scheme": "codenames", "host": "join" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "الشفرة العربية",
      "shortName": "الشفرة",
      "description": "لعبة الشفرة العربية الجماعية",
      "lang": "ar",
      "dir": "rtl",
      "display": "standalone",
      "startUrl": ".",
      "scope": ".",
      "orientation": "portrait",
      "themeColor": "#08121F",
      "backgroundColor": "#08121F",
      "barStyle": "black-translucent",
      "preferRelatedApplications": false,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#08121F"
      }
    }
  }
}
